<?xml version="1.0" encoding="utf-8"?>
<!-- Countries tab: filter chips + country list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a10">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Countries"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="All"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/chip"
                    android:textColor="#ffffff"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />

                <Button
                    android:id="@+id/chip_secure"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="🛡 Secure Core"
                    android:textSize="13sp"
                    android:background="@drawable/chip"
                    android:textColor="#9a93b8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/chip_p2p"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="⇄ P2P"
                    android:textSize="13sp"
                    android:background="@drawable/chip"
                    android:textColor="#9a93b8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/chip_tor"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="🧅 Tor"
                    android:textSize="13sp"
                    android:background="@drawable/chip"
                    android:textColor="#9a93b8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/countries_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Loading countries…"
            android:textColor="#9a93b8"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/country_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#1e1e2e"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <include layout="@layout/bottom_nav" />

</LinearLayout>
