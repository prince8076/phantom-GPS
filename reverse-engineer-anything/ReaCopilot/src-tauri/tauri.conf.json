{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReaCopilot",
  "version": "0.1.0",
  "identifier": "ai.omnirush.reacopilot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ReaCopilot - AI Reverse Engineering Workbench",
        "width": 1460,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "AI-assisted reverse-engineering workbench",
    "longDescription": "Local static analysis for executables with an AI copilot that reasons over sections, imports, strings, call targets and disassembly."
  }
}
